//@version=5
strategy("Crash 1000 M5 High-Probability LONG Strategy", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0, process_orders_on_close=false, commission_type=strategy.commission.percent, commission_value=0.01)

// ==========================================
// INPUT PARAMETERS & USER SETTINGS
// ==========================================
i_emaFast          = input.int(50, title="EMA Rapide (Fast Trend)", group="Indicateurs de Tendance")
i_emaSlow          = input.int(200, title="EMA Lente (Slow Trend)", group="Indicateurs de Tendance")

i_rsiLength        = input.int(14, title="Longueur RSI", group="Momentum RSI")
i_rsiMin           = input.int(50, title="RSI minimum (Confirmation Haussière)", group="Momentum RSI")
i_rsiMax           = input.int(68, title="RSI maximum (Éviter Surachat)", group="Momentum RSI")

i_macdFast         = input.int(12, title="MACD Fast Length", group="Momentum MACD")
i_macdSlow         = input.int(26, title="MACD Slow Length", group="Momentum MACD")
i_macdSignal       = input.int(9, title="MACD Signal Length", group="Momentum MACD")

i_atrLen           = input.int(14, title="Longueur ATR (Spike Filter)", group="Filtre Anti-Spike / Volatilité")
i_spikeThreshold   = input.float(2.5, title="Facteur de Seuil Spike (Multiplier ATR)", group="Filtre Anti-Spike / Volatilité", tooltip="Si la bougie récente dépasse ATR * Seuil, on considère qu'un spike récent a eu lieu")
i_candlesPostSpike = input.int(6, title="Nombre de bougies de stabilisation post-spike", group="Filtre Anti-Spike / Volatilité")

i_holdBars         = input.int(1, title="Durée de détention (Bougies M5)", minval=1, maxval=5, group="Gestion du Risk & Sortie", tooltip="1 bougie M5 = entrée à 10:35:00 et sortie à la clôture 10:39:59")
i_cooldownBars     = input.int(6, title="Cooldown / Pause minimale entre 2 trades (Bougies M5)", minval=1, maxval=50, group="Gestion du Risk & Sortie", tooltip="Empêche d'ouvrir un nouveau trade immédiatement après la clôture d'un trade")
i_stopLossPct      = input.float(20.0, title="Stop Loss (% de la marge / position)", minval=1.0, maxval=50.0, group="Gestion du Risk & Sortie")

// ==========================================
// CALCUL DES INDICATEURS POPULAIRES
// ==========================================
emaFastVal = ta.ema(close, i_emaFast)
emaSlowVal = ta.ema(close, i_emaSlow)

rsiVal = ta.rsi(close, i_rsiLength)

[macdLine, signalLine, histLine] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)

atrVal = ta.atr(i_atrLen)

// ==========================================
// FILTRE ET DÉTECTION DES SPIKES
// ==========================================
// Détection d'une bougie baissière anormale (Spike typique de Crash 1000)
isSpike = (open - close) > (atrVal * i_spikeThreshold)
var int barsSinceSpike = 999
if isSpike
    barsSinceSpike := 0
else
    barsSinceSpike := barsSinceSpike + 1

spikeFilterPassed = barsSinceSpike >= i_candlesPostSpike

// ==========================================
// FILTRES DE QUALITÉ ET ANTI-RISQUE STRICTS
// ==========================================
// 1. Tendance haussière solide + pente d'EMA positive
trendCondition = (close > emaFastVal) and (emaFastVal > emaSlowVal) and (emaFastVal > emaFastVal[1])

// 2. Momentum haussier en accélération (RSI croissant + MACD Histogramme croissant)
rsiCondition = (rsiVal >= i_rsiMin) and (rsiVal <= i_rsiMax) and (rsiVal > rsiVal[1])
macdCondition = (macdLine > signalLine) and (histLine > 0) and (histLine > histLine[1])
momentumCondition = rsiCondition and macdCondition

// 3. Bougie haussière solide (pas un doji / bougie faible)
candleBody = close - open
candleRange = high - low
solidBullishCandle = (candleBody > 0) and (candleRange > 0) and ((candleBody / candleRange) >= 0.35)

// ==========================================
// SUIVI DES FERMETURES & COOLDOWN
// ==========================================
var int lastExitBarIndex = -999

// Détection de la fermeture de position
if (strategy.position_size[1] > 0 and strategy.position_size == 0)
    lastExitBarIndex := bar_index

cooldownPassed = (bar_index - lastExitBarIndex) >= i_cooldownBars

// Condition globale d'achat ultra-sécurisée (calculée à la clôture d'une bougie)
longCondition = trendCondition and momentumCondition and solidBullishCandle and spikeFilterPassed and cooldownPassed

// ==========================================
// EXECUTION STRATEGY & SUIVI DES POSITIONS
// ==========================================
// L'ordre d'entrée est déclenché sur la condition validée et s'exécute immédiatement
// à la première seconde (ouverture `open`) de la bougie suivante (ex: 10:35:00 pile).
var int entryBarIndex = 0
bool tradeOpenedThisBar = false

if (longCondition and strategy.position_size == 0)
    strategy.entry("LONG_CRASH1000", strategy.long)
    entryBarIndex := bar_index + 1 // L'entrée effective se fait sur la bougie suivante à l'ouverture
    tradeOpenedThisBar := true

// Gestion du Stop Loss (20% de marge) et Take Profit à la fin de la bougie ciblée (10:39:59)
if (strategy.position_size > 0)
    // Calcul du Stop Loss en prix basé sur le % de marge/position autorisé
    float entryPrice = strategy.position_avg_price
    float slPrice = entryPrice * (1.0 - (i_stopLossPct / 100.0))

    // Fermeture automatique à la fin de la bougie M5 ciblée (ex: entrée à 10:35:00, sortie à 10:39:59 / 10:40:00)
    if (bar_index - entryBarIndex + 1 >= i_holdBars)
        strategy.close("LONG_CRASH1000", comment="TP_End_Candle_5min")

    // Envoi du niveau de Stop Loss à la stratégie
    strategy.exit("SL_Guard", "LONG_CRASH1000", stop=slPrice)

// ==========================================
// TRACÉS ET VISUALISATION GRAPHIQUE
// ==========================================
plot(emaFastVal, title="EMA 50", color=color.blue, linewidth=2)
plot(emaSlowVal, title="EMA 200", color=color.orange, linewidth=2)

// Affiche le signal uniquement sur la bougie où l'ordre est exécuté à l'ouverture (10:35:00)
plotshape(tradeOpenedThisBar[1], title="Signal LONG Ultra-Sûr (Entrée Ouverture)", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="BUY 10:35:00")

// Fond de graphique coloré pour repérer les tendances
bgcolor(trendCondition ? color.new(color.green, 92) : na)
